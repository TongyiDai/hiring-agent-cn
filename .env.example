# Default model to use (must exist in providers.json).
# Ollama examples: "gemma4:latest", "qwen3:4b", "mistral:7b"
# Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
DEFAULT_MODEL=gemma4:latest

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here

# Hiring Agent CN: optional guarded model refinement. The deterministic
# evidence matrix works without any model. Keep the local endpoint by default.
HA_CN_BASE_URL=http://127.0.0.1:11434/v1
HA_CN_MODEL=qwen3:4b
# HA_CN_API_KEY=

# Optional, only for candidate-provided public code links.
# GITHUB_TOKEN=
# GITEE_TOKEN=
# GITCODE_TOKEN=
